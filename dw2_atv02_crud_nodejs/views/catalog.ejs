<%- include('Partials/navbar.ejs') %>
<section class="catalog-hero"><div class="eyebrow">CATÁLOGO AMPLI</div><h1>ENCONTRE SEU <span>PRÓXIMO FAVORITO.</span></h1><p>Equipamentos para criar, tocar, treinar e jogar do seu jeito.</p></section><section class="catalog-section"><form class="catalog-toolbar" action="/produtos" method="get"><div class="category-filters"><% categories.forEach(c => { %><a class="filter-chip <%= category === c ? 'active' : '' %>" href="/produtos<%= c === 'Todos' ? '' : '?categoria=' + encodeURIComponent(c) %>"><%= c %></a><% }) %></div><div class="search-box"><input type="search" name="q" value="<%= q %>" placeholder="Buscar produto..." aria-label="Buscar produto"><% if(category !== 'Todos') { %><input type="hidden" name="categoria" value="<%= category %>"><% } %><button type="submit">⌕</button></div></form><div class="catalog-count"><span><strong><%= products.length %></strong> produto(s) encontrado(s)</span><span>PREÇOS EM REAIS (R$)</span></div><% if (products.length) { %><div class="product-grid catalog-grid"><% products.forEach((p,i) => { %><article class="product-card"><a href="/produto/<%= p.id %>" class="product-image-wrap"><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><span class="product-tag"><%= p.tag %></span><span class="product-arrow">↗</span></a><div class="product-meta"><span><%= p.category %></span><span>ITEM <%= String(i+1).padStart(2,'0') %></span></div><a class="product-name" href="/produto/<%= p.id %>"><h3><%= p.name %></h3></a><div class="product-buy"><strong><%= money(p.price) %></strong><button class="add-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-image="<%= p.image %>" aria-label="Adicionar <%= p.name %> à sacola">+</button></div></article><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><h2>Nenhum produto por aqui.</h2><p>Tente outra busca ou escolha uma categoria diferente.</p><a class="button button-primary" href="/produtos">Limpar filtros</a></div><% } %></section>
<%- include('Partials/footer.ejs') %>