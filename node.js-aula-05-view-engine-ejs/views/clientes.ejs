<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos</title>
</head>
<body>
    <h1 style="text-align: center;">Clientes</h1>
    <a href="/">Voltar</a>

      <table border="1">
        <tr>
            <th width="150px">Clientes</th>
            <th>CPF</th>
        </tr>
         <% clientes.forEach(cliente => { %>
            <tr>
                <td><%= cliente.nome %></td>
                <td><%= cliente.cpf %></td>
            </tr>
         <%})%>
      </table>
</body>
</html>