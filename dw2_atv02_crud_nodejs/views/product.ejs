<%- include('Partials/navbar.ejs') %>
<div class="breadcrumbs"><a href="/">Início</a><span>/</span><a href="/produtos">Produtos</a><span>/</span><span><%= product.name %></span></div><section class="product-detail"><div class="detail-image"><img src="<%= product.image %>" alt="<%= product.name %>"><span class="product-tag"><%= product.tag %></span></div><div class="detail-copy"><div class="eyebrow"><%= product.category %> / AMPLI SELECT</div><h1><%= product.name %></h1><p class="detail-price"><%= money(product.price) %></p><p class="detail-description"><%= product.description %></p><div class="detail-benefits"><span>✓ Produto selecionado pela AMPLI</span><span>✓ Compra demonstrativa para projeto acadêmico</span></div><button class="button button-primary detail-add add-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image %>">Adicionar à sacola <span>＋</span></button><a href="/produtos" class="text-link back-link">← Voltar ao catálogo</a></div></section><% if (related.length) { %><section class="featured-section related-section"><div class="section-heading"><div><div class="eyebrow">NA MESMA VIBE</div><h2>VOCÊ TAMBÉM PODE <span>CURTIR.</span></h2></div></div><div class="product-grid"><% related.forEach(p => { %><article class="product-card"><a href="/produto/<%= p.id %>" class="product-image-wrap"><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><span class="product-arrow">↗</span></a><div class="product-meta"><span><%= p.category %></span></div><a class="product-name" href="/produto/<%= p.id %>"><h3><%= p.name %></h3></a><div class="product-buy"><strong><%= money(p.price) %></strong><button class="add-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-image="<%= p.image %>">+</button></div></article><% }) %></div></section><% } %><%- include('Partials/footer.ejs') %>